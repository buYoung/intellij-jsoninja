<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.livteam.jsoninja</id>
    <name>JSONinja</name>
    <vendor email="leebu18@gmail.com">BuYoung</vendor>

    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.json</depends>

    <resource-bundle>messages.LocalizationBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <iconMapper mappingFile="JSONinjaIconMappings.json"/>
        <toolWindow factoryClass="com.livteam.jsoninja.ui.toolWindow.JsoninjaToolWindowFactory" id="JSONinja"
                    icon="com.livteam.jsoninja.icons.JsoninjaIcons.ToolWindowIcon"/>

        <projectConfigurable
                instance="com.livteam.jsoninja.settings.JsoninjaSettingsConfigurable"
                id="com.livteam.jsoninja.settings.JsoninjaSettingsConfigurable"
                key="settings.display.name"
                groupId="tools"
                nonDefaultProject="true"/>

        <diff.DiffExtension implementation="com.livteam.jsoninja.diff.JsonDiffExtension"/>

        <defaultHighlightingSettingProvider
                implementation="com.livteam.jsoninja.ui.component.convertType.highlighting.TypeCodePreviewHighlightingSettingProvider"
                order="first"/>
        <daemon.highlightInfoFilter
                implementation="com.livteam.jsoninja.ui.component.convertType.highlighting.TypeCodePreviewHighlightInfoFilter"/>

        <copyPastePreProcessor implementation="com.livteam.jsoninja.extensions.JsoninjaPastePreProcessor"/>
        <daemon.highlightInfoFilter
                implementation="com.livteam.jsoninja.extensions.JsoninjaTemplateHighlightErrorFilter"/>
        <gotoDeclarationHandler implementation="com.livteam.jsoninja.extensions.JsoninjaTemplateGotoDeclarationHandler"
                                order="first"/>

        <applicationService serviceImplementation="com.livteam.jsoninja.settings.JsoninjaSyncedSettingsState"/>
        <applicationService serviceImplementation="com.livteam.jsoninja.services.OnboardingStateService"/>

        <editorActionHandler action="ExpandCollapseToggleAction"
                             implementationClass="com.livteam.jsoninja.ui.component.editor.JsoninjaExpandCollapseToggleHandler"/>
        <postStartupActivity implementation="com.livteam.jsoninja.listeners.JsoninjaOnboardingStartupActivity"/>
        <notificationGroup id="JSONinja" displayType="BALLOON"/>
    </extensions>

    <actions>
        <!-- JSON Diff Actions Group -->
        <group id="com.livteam.jsoninja.action.group.DiffActions"
               icon="com.livteam.jsoninja.icons.JsoninjaIcons.DiffIconV3"
               popup="true">
            <action id="com.livteam.jsoninja.action.ShowJsonDiffAction"
                    class="com.livteam.jsoninja.actions.ShowJsonDiffAction"
                    icon="com.livteam.jsoninja.icons.JsoninjaIcons.DiffIconV3"/>
            <separator/>
            <action id="com.livteam.jsoninja.action.ShowJsonDiffInEditorTabAction"
                    class="com.livteam.jsoninja.actions.ShowJsonDiffInEditorTabAction"
                    icon="AllIcons.Actions.SplitVertically"/>
            <action id="com.livteam.jsoninja.action.ShowJsonDiffInWindowAction"
                    class="com.livteam.jsoninja.actions.ShowJsonDiffInWindowAction"
                    icon="AllIcons.Actions.MoveToWindow"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </group>

        <!-- JSON Diff Viewer Toolbar Actions (Keymap / Find Action) -->
        <action id="com.livteam.jsoninja.action.SortJsonDiffKeysOnceAction"
                class="com.livteam.jsoninja.actions.SortJsonDiffKeysOnceAction"
                icon="AllIcons.ObjectBrowser.SortByType"/>
        <action id="com.livteam.jsoninja.action.SelectJsonDiffSortModeAction"
                class="com.livteam.jsoninja.actions.SelectJsonDiffSortModeAction"/>
        <action id="com.livteam.jsoninja.action.ToggleJsonDiffAutoSortAction"
                class="com.livteam.jsoninja.actions.ToggleJsonDiffAutoSortAction"
                icon="AllIcons.ObjectBrowser.Sorted"/>
        <action id="com.livteam.jsoninja.action.ToggleJsonDiffArrayOrderAction"
                class="com.livteam.jsoninja.actions.ToggleJsonDiffArrayOrderAction"
                icon="AllIcons.Json.Array"/>
        <action id="com.livteam.jsoninja.action.RestoreJsonDiffSortAction"
                class="com.livteam.jsoninja.actions.RestoreJsonDiffSortAction"
                icon="AllIcons.Actions.Rollback"/>
        <action id="com.livteam.jsoninja.action.SwapJsonDiffSidesAction"
                class="com.livteam.jsoninja.actions.SwapJsonDiffSidesAction"
                icon="AllIcons.Actions.SwapPanels"/>
        <action id="com.livteam.jsoninja.action.RenameJsonDiffTitlesAction"
                class="com.livteam.jsoninja.actions.RenameJsonDiffTitlesAction"
                icon="AllIcons.Actions.Edit"/>
        <action id="com.livteam.jsoninja.action.SwitchJsonDiffDisplayModeAction"
                class="com.livteam.jsoninja.actions.SwitchJsonDiffDisplayModeAction"/>

        <!-- JSONinja Tool Window Actions -->
        <group id="com.livteam.jsoninja.action.group.ToolWindowActions">
            <action id="com.livteam.jsoninja.action.AddTabAction"
                    class="com.livteam.jsoninja.actions.AddTabAction"
                    icon="AllIcons.General.Add"/>
            <action id="com.livteam.jsoninja.action.OpenJsonFileAction"
                    class="com.livteam.jsoninja.actions.OpenJsonFileAction"
                    icon="com.livteam.jsoninja.icons.JsoninjaIcons.OpenJsonFileIconV3"/>
            <separator/>
            <action id="com.livteam.jsoninja.action.PrettifyJsonAction"
                    class="com.livteam.jsoninja.actions.PrettifyJsonAction"
                    icon="com.livteam.jsoninja.icons.JsoninjaIcons.PrettyIconV3"/>
            <action id="com.livteam.jsoninja.action.UglifyJsonAction"
                    class="com.livteam.jsoninja.actions.UglifyJsonAction"
                    icon="com.livteam.jsoninja.icons.JsoninjaIcons.UglyIconV3"/>
            <action id="com.livteam.jsoninja.action.EscapeJsonAction"
                    class="com.livteam.jsoninja.actions.EscapeJsonAction"
                    icon="com.livteam.jsoninja.icons.JsoninjaIcons.EscapeIconV3"/>
            <action id="com.livteam.jsoninja.action.UnescapeJsonAction"
                    class="com.livteam.jsoninja.actions.UnescapeJsonAction"
                    icon="com.livteam.jsoninja.icons.JsoninjaIcons.UnescapeIconV3"/>
            <separator/>
            <action id="com.livteam.jsoninja.action.GenerateRandomJsonAction"
                    class="com.livteam.jsoninja.actions.GenerateRandomJsonAction"
                    icon="com.livteam.jsoninja.icons.JsoninjaIcons.GenerateIconV3"/>
            <reference ref="com.livteam.jsoninja.action.ShowJsonDiffAction"/>
            <action id="com.livteam.jsoninja.action.TypeConversionAction"
                    class="com.livteam.jsoninja.actions.TypeConversionAction"/>
            <action id="com.livteam.jsoninja.action.LoadJsonFromApiAction"
                    class="com.livteam.jsoninja.actions.LoadJsonFromApiAction"
                    icon="com.livteam.jsoninja.icons.JsoninjaIcons.LoadJsonFromApiIconV3"/>
            <separator/>
            <action id="com.livteam.jsoninja.action.CloseTabAction"
                    class="com.livteam.jsoninja.actions.CloseTabAction"/>
            <action id="com.livteam.jsoninja.action.OpenSettingsAction"
                    class="com.livteam.jsoninja.actions.OpenSettingsAction"
                    icon="AllIcons.General.Settings"/>
        </group>
        <action id="com.livteam.jsoninja.action.CopyJsonQueryAction"
                class="com.livteam.jsoninja.actions.CopyJsonQueryAction"
        >
        </action>
        <action id="com.livteam.jsoninja.action.CopyJsonArrayQueryAction"
                class="com.livteam.jsoninja.actions.CopyJsonArrayQueryAction"/>

        <action id="com.livteam.jsoninja.action.TypeConversionAction.Menu"
                class="com.livteam.jsoninja.actions.TypeConversionAction">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <group id="com.livteam.jsoninja.action.group.EditorPopup" popup="false">
            <reference ref="com.livteam.jsoninja.action.CopyJsonQueryAction"/>
            <reference ref="com.livteam.jsoninja.action.CopyJsonArrayQueryAction"/>
        </group>

        <!-- JSONinja Editor Context Menu Actions -->
        <group id="com.livteam.jsoninja.action.group.EditorContextMenu" popup="true">
            <action id="com.livteam.jsoninja.action.editor.EditorPrettifyJsonAction"
                    class="com.livteam.jsoninja.actions.editor.EditorPrettifyJsonAction"/>
            <action id="com.livteam.jsoninja.action.editor.EditorUglifyJsonAction"
                    class="com.livteam.jsoninja.actions.editor.EditorUglifyJsonAction"/>
            <separator/>
            <action id="com.livteam.jsoninja.action.editor.EditorEscapeJsonAction"
                    class="com.livteam.jsoninja.actions.editor.EditorEscapeJsonAction"/>
            <action id="com.livteam.jsoninja.action.editor.EditorUnescapeJsonAction"
                    class="com.livteam.jsoninja.actions.editor.EditorUnescapeJsonAction"/>
            <separator/>
            <action id="com.livteam.jsoninja.action.editor.EditorShowJsonDiffAction"
                    class="com.livteam.jsoninja.actions.editor.EditorShowJsonDiffAction"
                    icon="com.livteam.jsoninja.icons.JsoninjaIcons.DiffIconV3"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>

    </actions>
</idea-plugin>
